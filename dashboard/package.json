{
  "name": "verity-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "node run-backend.js",
    "dev:frontend": "next dev -p 3000",
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"yellow,cyan\" \"node run-backend.js\" \"next dev -p 3000\"",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint"
  },


  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lenis": "^1.1.18",
    "lucide-react": "^0.460.0",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
